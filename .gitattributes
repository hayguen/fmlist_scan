# Enforce LF for scripts and config files used on Linux/Raspberry Pi.
*.py text eol=lf
*.sh text eol=lf
*.inc text eol=lf
*.service text eol=lf
*.conf text eol=lf
config text eol=lf
config_defaults text eol=lf
src/build_* text eol=lf
src/inst_* text eol=lf
src/prereq_* text eol=lf
src/setup* text eol=lf
src/uninstall* text eol=lf
src/*/CMakeLists.txt text eol=lf

# Keep Windows batch files CRLF if they exist.
*.bat text eol=crlf
*.cmd text eol=crlf
