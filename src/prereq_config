
BASE=$(pwd)

if [ -z "${FMLIST_SCAN_USER}" ]; then
  export FMLIST_SCAN_USER="pi"
fi
if [ -z "${FMLIST_SCAN_RASPI}" ]; then
  export FMLIST_SCAN_RASPI="1"
fi
if [ -z "${FMLIST_SCAN_SETUP_GPS}" ]; then
  export FMLIST_SCAN_SETUP_GPS="1"
fi
if [ "${FMLIST_SCAN_SETUP_GPS}" = "1" ]; then
  export GPS_DEFAULT="auto"
else
  export GPS_DEFAULT="static"
fi

if [ -z "${FMLIST_SCAN_MOUNT}" ]; then
  export FMLIST_SCAN_MOUNT="1"
fi
if [ -z "${FMLIST_SCAN_RESULT_DEV}" ]; then
  export FMLIST_SCAN_RESULT_DEV="/dev/sda1"
fi
if [ -z "${FMLIST_SCAN_RESULT_DIR}" ]; then
  export FMLIST_SCAN_RESULT_DIR="/mnt/sda1"
fi

CONF_DIR="/home/${FMLIST_SCAN_USER}/.config/fmlist_scan"
sudo -u ${FMLIST_SCAN_USER} bash -c "mkdir -p ${CONF_DIR}"

CONF_BAK_DIR="/home/${FMLIST_SCAN_USER}/.config/fmlist_scan_$(date -u "+%Y-%m-%d")"
if [ -d "${CONF_DIR}" ]; then
  if [ ! -d "${CONF_BAK_DIR}" ]; then
    sudo -u ${FMLIST_SCAN_USER} bash -c "mkdir -p ${CONF_BAK_DIR}"
    sudo -u ${FMLIST_SCAN_USER} bash -c "cp ${CONF_DIR}/* ${CONF_BAK_DIR}/"
  fi
fi


(
# set defaults
source conf/config_defaults

if [ -f /home/${FMLIST_SCAN_USER}/.config/fmlist_scan/config ]; then
  echo ""
  echo "ATTENTION:"
  echo "reading settings from /home/${FMLIST_SCAN_USER}/.config/fmlist_scan/config"
  echo "environment settings will be ignored for variables set in this config file"
  echo "in case you want a fresh installation:"
  echo "  press Ctrl-C now, remove that config file and restart setup"
  echo ""
  echo "sleeping 3 secs before continuation .."
  sleep 3
  echo "continuing."
  source /home/${FMLIST_SCAN_USER}/.config/fmlist_scan/config
fi

# set FMLIST_SCAN_RESULT_DSK from FMLIST_SCAN_RESULT_DEV for some device names
if [ -z "${FMLIST_SCAN_RESULT_DSK}" ]; then
  if [ "${FMLIST_SCAN_RESULT_DEV}" = "/dev/sda1" ]; then
    export FMLIST_SCAN_RESULT_DSK="/dev/sda"
  elif [ "${FMLIST_SCAN_RESULT_DEV}" = "/dev/sdb1" ]; then
    export FMLIST_SCAN_RESULT_DSK="/dev/sdb"
  elif [ "${FMLIST_SCAN_RESULT_DEV}" = "/dev/sdc1" ]; then
    export FMLIST_SCAN_RESULT_DSK="/dev/sdc"
  elif [ "${FMLIST_SCAN_RESULT_DEV}" = "/dev/sdd1" ]; then
    export FMLIST_SCAN_RESULT_DSK="/dev/sdd"
  fi
fi

# envsubst requires the package  gettext-base
cat conf/config \
  | sed "s#\$(pwd)#$(pwd)#g" \
  | envsubst \
  | sed 's/$%/$/g' \
  > /home/${FMLIST_SCAN_USER}/.config/fmlist_scan/config

REF_DAB_ENS_FILE="/home/${FMLIST_SCAN_USER}/.config/fmlist_scan/${FMLIST_QTH_PREFIX}_dab_ensembles.csv"
REF_DAB_ENS_README="${REF_DAB_ENS_FILE}.README"
REF_DAB_PRG_FILE="/home/${FMLIST_SCAN_USER}/.config/fmlist_scan/${FMLIST_QTH_PREFIX}_dab_programs.csv"
REF_DAB_PRG_README="${REF_DAB_PRG_FILE}.README"
REF_FM_PRG_FILE="/home/${FMLIST_SCAN_USER}/.config/fmlist_scan/${FMLIST_QTH_PREFIX}_fm_programs.csv"
REF_FM_PRG_README="${REF_FM_PRG_FILE}.README"

if [ ! -f "${REF_DAB_ENS_FILE}" ]; then
  : >"${REF_DAB_ENS_FILE}"
fi

if [ ! -f "${REF_DAB_ENS_README}" ]; then
  cat >"${REF_DAB_ENS_README}" <<EOF
these ensembles are already known for the ${FMLIST_QTH_PREFIX} QTH

put one ensemble key per line in this form:
0xa101,"DAB+ Austria    "

notes:
- keep ${FMLIST_QTH_PREFIX}_dab_ensembles.csv machine-readable; do not add comments there
- key format is EId + ensemble name (channel-independent)
- string fields are quoted exactly as emitted by dab-rtlsdr/dab-raw CSV output
- if you edit the CSV manually, keep lines sorted
- the scanner will add newly discovered ensembles automatically
EOF
fi

if [ ! -f "${REF_DAB_PRG_FILE}" ]; then
  : >"${REF_DAB_PRG_FILE}"
fi

if [ ! -f "${REF_DAB_PRG_README}" ]; then
  cat >"${REF_DAB_PRG_README}" <<EOF
these DAB programs are already known for the ${FMLIST_QTH_PREFIX} QTH

copy lines from scanEval output or from a recorded dab_programs.csv file.

notes:
- keep ${FMLIST_QTH_PREFIX}_dab_programs.csv machine-readable; do not add comments there
- keep lines sorted if you edit the file manually
- this file is compared with comm in scanEvalSummary.sh
EOF
fi

if [ ! -f "${REF_FM_PRG_FILE}" ]; then
  : >"${REF_FM_PRG_FILE}"
fi

if [ ! -f "${REF_FM_PRG_README}" ]; then
  cat >"${REF_FM_PRG_README}" <<EOF
these FM programs are already known for the ${FMLIST_QTH_PREFIX} QTH

copy lines from scanEval output or from a recorded fm_programs.csv file.

notes:
- keep ${FMLIST_QTH_PREFIX}_fm_programs.csv machine-readable; do not add comments there
- keep lines sorted if you edit the file manually
- this file is compared with comm in scanEvalSummary.sh
EOF
fi
)

cat conf/fmscan.inc       >/home/${FMLIST_SCAN_USER}/.config/fmlist_scan/fmscan.inc
cat conf/dabscan.inc      >/home/${FMLIST_SCAN_USER}/.config/fmlist_scan/dabscan.inc
cat conf/dab_chanlist.txt >/home/${FMLIST_SCAN_USER}/.config/fmlist_scan/dab_chanlist.txt

if [ ! -f /home/${FMLIST_SCAN_USER}/.config/fmlist_scan/local_GPS_COORDS.inc ]; then
  cat conf/local_GPS_COORDS.inc    >/home/${FMLIST_SCAN_USER}/.config/fmlist_scan/local_GPS_COORDS.inc
fi
if [ ! -f /home/${FMLIST_SCAN_USER}/.config/fmlist_scan/local_SUN_TIMES.inc ]; then
  cat conf/local_SUN_TIMES.inc     >/home/${FMLIST_SCAN_USER}/.config/fmlist_scan/local_SUN_TIMES.inc
fi

CFG_FILE="/home/${FMLIST_SCAN_USER}/.config/fmlist_scan/config"
QTH_PREFIX_FOR_FILES="$(sed -n 's/^export FMLIST_QTH_PREFIX="\(.*\)".*/\1/p' "${CFG_FILE}" | head -n1)"
if [ -z "${QTH_PREFIX_FOR_FILES}" ]; then
  QTH_PREFIX_FOR_FILES="local"
fi

chown ${FMLIST_SCAN_USER}:${FMLIST_SCAN_USER} /home/${FMLIST_SCAN_USER}/.config/fmlist_scan/config
for f in \
  "/home/${FMLIST_SCAN_USER}/.config/fmlist_scan/${QTH_PREFIX_FOR_FILES}_dab_ensembles.csv" \
  "/home/${FMLIST_SCAN_USER}/.config/fmlist_scan/${QTH_PREFIX_FOR_FILES}_dab_ensembles.csv.README" \
  "/home/${FMLIST_SCAN_USER}/.config/fmlist_scan/${QTH_PREFIX_FOR_FILES}_dab_programs.csv" \
  "/home/${FMLIST_SCAN_USER}/.config/fmlist_scan/${QTH_PREFIX_FOR_FILES}_dab_programs.csv.README" \
  "/home/${FMLIST_SCAN_USER}/.config/fmlist_scan/${QTH_PREFIX_FOR_FILES}_fm_programs.csv" \
  "/home/${FMLIST_SCAN_USER}/.config/fmlist_scan/${QTH_PREFIX_FOR_FILES}_fm_programs.csv.README"
do
  if [ -f "${f}" ]; then
    chown ${FMLIST_SCAN_USER}:${FMLIST_SCAN_USER} "${f}"
  fi
done
chown ${FMLIST_SCAN_USER}:${FMLIST_SCAN_USER} /home/${FMLIST_SCAN_USER}/.config/fmlist_scan/fmscan.inc
chown ${FMLIST_SCAN_USER}:${FMLIST_SCAN_USER} /home/${FMLIST_SCAN_USER}/.config/fmlist_scan/dabscan.inc
chown ${FMLIST_SCAN_USER}:${FMLIST_SCAN_USER} /home/${FMLIST_SCAN_USER}/.config/fmlist_scan/dab_chanlist.txt
chown ${FMLIST_SCAN_USER}:${FMLIST_SCAN_USER} /home/${FMLIST_SCAN_USER}/.config/fmlist_scan/local_GPS_COORDS.inc
chown ${FMLIST_SCAN_USER}:${FMLIST_SCAN_USER} /home/${FMLIST_SCAN_USER}/.config/fmlist_scan/local_SUN_TIMES.inc

sudo -u ${FMLIST_SCAN_USER} bash -c "mkdir -p /home/${FMLIST_SCAN_USER}/bin"
cp scanner/scanFM_tef.py /home/${FMLIST_SCAN_USER}/bin/
chown ${FMLIST_SCAN_USER}:${FMLIST_SCAN_USER} /home/${FMLIST_SCAN_USER}/bin/scanFM_tef.py

cd ${BASE}
